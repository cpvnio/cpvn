{"sym":"DRL","updated":"2026-08-02","v":2,"nameVi":"CTCP Thủy điện - Điện Lực 3","nameEn":"Hydro Power Joint Stock Company - Power No.3","website":"https://www.pc3hp.com.vn","exchange":"HOSE","industry":"Tiện ích điện và sản xuất điện ","sectorParent":"Tiện ích","overview":"<div style=\"FONT-FAMILY: Arial; FONT-SIZE: 10pt;\">Công ty Cổ phần Thủy điện – Điện lực 3 (DRL) được thành lập ngày 20/11/2003. Công ty hoạt động chính trong lĩnh vực sản xuất và kinh doanh điện. Hiện công ty đang quản lý và vận hành nhà máy Thủy điện Đrây H’Linh 2 tại Đăk Lăk, sản xuất điện thương phẩm để cung cấp trực tiếp và duy nhất cho Tổng Công ty Điện lực miền Trung (CPC). Địa bàn kinh doanh của công ty bao gồm hai tỉnh Đăk Nông và Đăk Lăk. DRL chính thức được giao dịch tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (HOSE) từ năm 2012.</div>\r\n","roe":35.89,"roa":32.52,"beta5y":0.21,"freeFloat":65.0,"bookValue":13616.7,"eps":4707.65,"evEbitda":5.38,"revLtmGrowth":-3.31,"npLtmGrowth":-8.5,"riskLevel":"high","shares":9500000.0,"sh":[{"n":"Central Power Corporation","p":30.42,"s":2890000.0,"c":"Vietnam"},{"n":"Nguyen (Dung Xuan)","p":2.65,"s":251590.0,"c":"Vietnam"},{"n":"Ha (Chuong Van)","p":0.71,"s":67550.0,"c":"Vietnam"},{"n":"Pham (Nhung Thi Bich)","p":0.46,"s":44090.0,"c":"Vietnam"},{"n":"Tran (Son Ky)","p":0.42,"s":40000.0,"c":"Vietnam"},{"n":"Nguyen (Tien Minh)","p":0.32,"s":30000.0,"c":"Vietnam"},{"n":"Nguyen (Su Thi)","p":0.32,"s":30000.0,"c":"Vietnam"},{"n":"Tran (Hai Ky)","p":0.21,"s":20000.0,"c":"Vietnam"},{"n":"Tran (Nhac Ky)","p":0.21,"s":20000.0,"c":"Vietnam"},{"n":"Lam (Uyen)","p":0.16,"s":15000.0,"c":"Vietnam"},{"n":"Pham (Hung Duc)","p":0.13,"s":12600.0,"c":"Vietnam"},{"n":"Le (Hung Kim)","p":0.11,"s":10000.0,"c":"Vietnam"},{"n":"Nguyen (Son)","p":0.11,"s":10000.0,"c":"Vietnam"},{"n":"Hoang (Trang Thi Thu)","p":0.11,"s":10000.0,"c":"Vietnam"},{"n":"Nguyen (Thanh)","p":0.11,"s":10000.0,"c":"Australia"},{"n":"Nguyen (Duc Van)","p":0.05,"s":5000.0,"c":"Vietnam"},{"n":"Pha