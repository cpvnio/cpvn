{"sym":"PAT","updated":"2026-08-02","v":2,"nameVi":"CTCP Phốt pho Apatit Việt Nam","website":"https://pacvietnam.vn/","exchange":"UPCOM","industry":"Hóa chất","sectorParent":"Nguyên vật liệu","overview":"<div style=\"FONT-FAMILY: Arial; FONT-SIZE: 10pt;\">Công ty Cổ phần Phốt pho Apatit Việt Nam (PAT) được thành lập vào năm 2014. Công ty hoạt động chính trong lĩnh vực sản xuất, chế biến và kinh doanh phốt pho vàng và các sản phẩm khác có nguồn gốc từ phốt pho vàng và apatit, axit phốt-pho-ríc. Công ty hiện đang vận hành dây chuyền sản xuất chế biến phốt pho vàng với công suất 20.000 tấn/năm tại Khu công nghiệp Tằng Loỏng, huyện Bảo Thắng, tỉnh Lào Cai. Sản phảm của công ty chủ yếu được xuất khẩu các nước Ấn Độ, Ý,... PAT chính thức được giao dịch tại Thị trường UPCoM từ ngày 17/06/2022.</div>\r\n","roe":48.88,"roa":34.14,"bookValue":29693.56,"eps":13661.01,"evEbitda":2.9,"revLtmGrowth":-1.03,"npLtmGrowth":9.9,"riskLevel":"high","shares":25000000.0,"sh":[{"n":"Duc Giang Chemicals Jsc","p":51.0,"s":12750422.0,"c":"Vietnam"},{"n":"Dao (Anh Huu Duy)","p":9.03,"s":2258333.0,"c":"Vietnam"},{"n":"Dao (Huyen Huu)","p":7.69,"s":1921666.0,"c":"Vietnam"},{"n":"Nguyen (Lan Thi Hong)","p":0.67,"s":166666.0,"c":"Vietnam"},{"n":"Ngo (Lan Thi Ngoc)","p":0.67,"s":166666.0,"c":"Vietnam"},{"n":"Dao (Kha Huu)","p":0.67,"s":166666.0,"c":"Vietnam"},{"n":"Pham (Hung Van)","p":0.43,"s":107066.0,"c":"Vietnam"},{"n":"Dao (Hanh Hong)","p":0.33,"s":83333.0,"c":"Vietnam"},{"n":"Bui (Thu Thi Ha)","p":0.33,"s":83333.0,"c":"Vietnam"},{"n":"Dao (Phuong Thi)","p":0.21,"s":52666.0,"c":"Vietnam"},{"n":"Vuong (Hung Quoc)","p":0.13,"s":32000.0,"c":"Vietnam"},{"n":"Dao (Hue Thi)","p":0.08,"s":20000.0,"c":"Vietnam"},{"n":"Dang (Duc Tien)","p":0.08,"s":19331.0,"c":"Vietnam"},{"n":"Pham (Phuong Thi Bich)","p":0.07,"s":16732.0,"c":"Vietnam"},{"n":"Dao (Huyen Thi)","p":0.04,"s":10000.0,"c":"Vietnam"},{"n":"Dao (Quyen Thi)","p":0.04,"s":10000.0,"c":"Vietnam"},{"n":"Nguyen (Cuong Hung)","p":0.0,"s":333.0,"c":"V