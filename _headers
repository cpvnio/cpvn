# TRANG HTML: PHẢI LUÔN HỎI LẠI MÁY CHỦ.
# Bốn trang này KHÔNG chỉ là vỏ — gần hết mạch JS của site nằm INLINE trong chúng
# (cophieu.html một mình đã hơn 1.500 dòng: nến, bảng tài chính, vòng giá sống). Mà chỉ
# `assets/*.js` mới có `?v=` để ép tải bản mới; HTML thì không có cơ chế nào tương đương.
# Nên nếu trình duyệt giữ bản HTML cũ thì người dùng chạy code cũ mà KHÔNG CÓ CÁCH NÀO
# BIẾT: vá xong, đẩy xong, mở lên vẫn thấy đúng lỗi ấy. ETag lo phần tiết kiệm băng thông,
# nên "hỏi lại mỗi lần" gần như không tốn gì.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/cophieu
  Cache-Control: public, max-age=0, must-revalidate
/cophieu.html
  Cache-Control: public, max-age=0, must-revalidate
/cophieu/*
  Cache-Control: public, max-age=0, must-revalidate
/bubbles
  Cache-Control: public, max-age=0, must-revalidate
/bubbles.html
  Cache-Control: public, max-age=0, must-revalidate
/congcu
  Cache-Control: public, max-age=0, must-revalidate
/congcu.html
  Cache-Control: public, max-age=0, must-revalidate
/radar
  Cache-Control: public, max-age=0, must-revalidate
/tapdoan
  Cache-Control: public, max-age=0, must-revalidate
/duongdua
  Cache-Control: public, max-age=0, must-revalidate
# Trang ẩn /fun — cả mạch JS nằm inline trong file, đúng lý do của luật ngay trên.
/fun
  Cache-Control: public, max-age=0, must-revalidate
/fun.html
  Cache-Control: public, max-age=0, must-revalidate

# Logo doanh nghiệp: đã kho hoá trong repo, nội dung gắn liền tên mã và gần như không đổi
# -> cho trình duyệt giữ 1 NĂM. Vào lần sau không tốn byte nào, hiện tức thì.
/assets/logo/*
  Cache-Control: public, max-age=31536000, immutable

# Logo/icon thương hiệu CPVN
/assets/logo-*.png
  Cache-Control: public, max-age=604800

# KHO DỮ LIỆU: đổi mỗi phiên -> KHÔNG cache dài, luôn hỏi lại máy chủ (ETag lo phần tiết kiệm)
#
# CẨN THẬN: `_headers` của Cloudflare CỘNG DỒN header của MỌI luật cùng khớp, KHÔNG phải
# luật hẹp đè luật rộng. Đo được 18/08 trên board.json:
#     Cache-Control: public, max-age=300, must-revalidate, public, max-age=60, must-revalidate
# Hai `max-age` trong một header là header HỎNG — bên đọc lấy cái đầu (300) hoặc bỏ cả dòng.
# Muốn một đường có luật riêng thì phải LOẠI nó khỏi luật rộng, đừng chỉ thêm luật hẹp.
# Nhưng CÁCH AN TOÀN NHẤT là đừng để hai luật cùng khớp: MỘT luật cho cả /data/*.
# (Đã thử mẫu lớp ký tự `/data/[!b]*` rồi bỏ — Cloudflare không tài liệu hoá cú pháp đó,
#  mà lúc build đang hỏng thì không được thêm biến số lạ nào.)
/data/*
  Cache-Control: public, max-age=60, must-revalidate

# GIÁ TRONG PHIÊN: máy cào ghi mỗi 5 phút -> cache ngắn hơn phần kho còn lại để độ trễ
# thấy được không cộng dồn (nhịp 5 phút + cache 60s = tối đa 6 phút).
# ĐÃ LOẠI khỏi luật rộng bằng mẫu /data/[!b]* — xem cảnh báo cộng dồn header ở trên.
# Cloudflare vẫn cache ở biên nên nghìn khách cùng lúc chỉ thành vài lượt về gốc.

# universe: đổi 1 lần/ngày -> cache 5 phút như data/ (F5 không tải lại 600KB)
/universe.json
  Cache-Control: public, max-age=300, must-revalidate

# Hình bản đồ thế giới: biên giới quốc gia không đổi theo phiên -> cache 1 NĂM.
# Muốn đổi thì nâng ?v= trong assets/congcu.js, y như mọi asset khác.
/assets/worldmap.json
  Cache-Control: public, max-age=31536000, immutable

# Ảnh thẻ chia sẻ: đổi thì nâng ?v= trong các thẻ og:image, nên cache 1 năm.
/assets/og.jpg
  Cache-Control: public, max-age=31536000, immutable
