# Logo doanh nghiệp: đã kho hoá trong repo, nội dung gắn liền tên mã và gần như không đổi
# -> cho trình duyệt giữ 1 NĂM. Vào lần sau không tốn byte nào, hiện tức thì.
/assets/logo/*
  Cache-Control: public, max-age=31536000, immutable

# Logo/icon thương hiệu CPVN
/assets/logo-*.png
  Cache-Control: public, max-age=604800

# KHO DỮ LIỆU: đổi mỗi phiên -> KHÔNG cache dài, luôn hỏi lại máy chủ (ETag lo phần tiết kiệm)
/data/*
  Cache-Control: public, max-age=300, must-revalidate

# universe: đổi 1 lần/ngày -> cache 5 phút như data/ (F5 không tải lại 600KB)
/universe.json
  Cache-Control: public, max-age=300, must-revalidate

# Hình bản đồ thế giới: biên giới quốc gia không đổi theo phiên -> cache 1 NĂM.
# Muốn đổi thì nâng ?v= trong assets/congcu.js, y như mọi asset khác.
/assets/worldmap.json
  Cache-Control: public, max-age=31536000, immutable

# Ảnh thẻ chia sẻ: đổi thì nâng ?v= trong các thẻ og:image, nên cache 1 năm.
/assets/og.jpg
  Cache-Control: public, max-age=31536000, immutable
